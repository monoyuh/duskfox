# ============================================================================
#  Duskfox - personal Firefox 140 ESR build
#  Haswell (i5-4670K), 4 cores, 13GB RAM; MAX SPEED, speed>security
# ============================================================================

# ---- application ----
ac_add_options --enable-application=browser
ac_add_options --target=x86_64-pc-linux-gnu
ac_add_options --enable-default-toolkit=cairo-gtk3-x11-wayland

# ---- release ----
ac_add_options --enable-release
ac_add_options --disable-debug
ac_add_options --disable-debug-symbols
ac_add_options --disable-tests
ac_add_options --enable-strip

# ---- optimisations ----
ac_add_options --enable-lto=thin
ac_add_options --enable-jemalloc
ac_add_options --enable-linker=lld
ac_add_options --enable-optimize="-O3 -march=haswell"
ac_add_options --enable-rust-simd
ac_add_options --enable-wasm-avx

# ---- media ----
# Build graphite/ogg/hunspell/expat/woff2/soundtouch NATIVELY instead of via
# RLBox wasm2c sandboxing: avoids a wasi sysroot/toolchain mismatch and is
# faster (no sandbox indirection). Speed > security.
ac_add_options --without-wasm-sandboxed-libraries
ac_add_options --enable-sandbox
ac_add_options --enable-raw
ac_add_options --enable-webrtc
ac_add_options --enable-pulseaudio
ac_add_options --enable-alsa
ac_add_options --enable-eme=widevine

# ---- add-ons ----
ac_add_options --allow-addon-sideload
ac_add_options --with-unsigned-addon-scopes=app,system

# ---- disable bloat / reporting ----
ac_add_options --disable-crashreporter
ac_add_options --disable-updater
ac_add_options --disable-parental-controls

# ---- branding ----
ac_add_options --with-app-name=duskfox
ac_add_options --with-app-basename=Duskfox
ac_add_options --with-branding=browser/branding/duskfox
ac_add_options --with-distribution-id=org.duskfox
# Product identity: feeds application.ini's Vendor= field and the compiled
# --version string, so neither ever says "Mozilla". Profile location is
# unaffected on Linux (it keys off MOZ_APP_NAME, not the vendor).
# NB: configure rejects MOZ_APP_VENDOR from mozconfig (accepted origin is
# "implied" only), so the real value is patched into browser/moz.configure
# by scripts/apply.sh step 7.

# ---- build ----
mk_add_options MOZ_MAKE_FLAGS="-j4"
mk_add_options AUTOCLOBBER=1
export AUTOCLOBBER=1
export MOZILLA_OFFICIAL=1
mk_add_options MOZILLA_OFFICIAL=1

# ---- rust ----
export OPT_LEVEL="3"
export RUSTC_OPT_LEVEL="3"
export RUSTFLAGS="-C target-cpu=haswell -C codegen-units=1"
export MOZ_LTO=1

# PGO optional
if test "$GEN_PGO"; then
    ac_add_options --enable-profile-generate=cross
elif test "$USE_PGO"; then
    ac_add_options --enable-profile-use=cross
    ac_add_options --with-pgo-profile-path="$PWD/pgo.profdata"
fi
